# Kopieer dit bestand naar backend/.env en vul in wat je nodig hebt.
# Zonder .env draait alles gewoon — de AI-laag valt dan terug op regels.
# ⚠️ Zet NOOIT echte keys in dit bestand: .env.example staat op GitHub.
#    Echte waarden horen in backend/.env (dat negeert git automatisch).

# Claude API-key (https://platform.claude.com) — activeert echte AI-antwoorden
# in de assistent en het herschrijven van gast-drafts in de inbox.
# ANTHROPIC_API_KEY=sk-ant-...

# Model voor de AI-laag (standaard: claude-opus-5)
# STAYBASE_AI_MODEL=claude-opus-5

# Koppelpunt voor de ORQ.AI-gateway uit de analyse: zet dit op de
# gateway-URL zodra die er is en de code blijft ongewijzigd.
# STAYBASE_AI_BASE_URL=

# Guesty Open API (koppeling met het Guesty-account van Staybase/Linnois).
# Aanmaken in Guesty: Settings → Integrations → API → "Create new API key/app"
# → kies scope "Open API" en kopieer client-id + secret hierheen.
# ⚠️ Guesty geeft maar ± 5 tokens per 24 u — de app cachet het token zelf.
# GUESTY_CLIENT_ID=0oa...
# GUESTY_CLIENT_SECRET=...

# Mapbox-token (https://account.mapbox.com) — voor de kaartweergave op /panden.
# De frontend krijgt hem via GET /api/client-config; zonder token toont de
# kaartweergave een nette melding.
# MAPBOX_TOKEN=pk....

# Supabase — de app draait volledig op Supabase Postgres (VERPLICHT).
# Connectiestring: dashboard → Settings → Database → Connection string (URI).
# SUPABASE_DB_URL=postgresql://postgres:<wachtwoord>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_URL=https://<project>.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...   (⚠️ geheim — alleen in backend/.env, nooit hier)

# Poort van de API (standaard 4000)
# API_PORT=4000
